  {
    "test_id": "error_buffer_ingest_rate_exceeded_001",
    "category": "error_taxonomy",
    "protocol_version": "1.0",
    "description": "CONTRACT_SPEC.md §7.6 + §14.2: an over-budget ingest returns 429 BufferError 'ingest_rate_exceeded' with a Retry-After header.",
    "input": {
      "request": {
        "method": "POST",
        "path": "/v1/ingest",
        "headers": { "Content-Type": "application/octet-stream", "X-Cephios-API-Version": "1.0", "X-Cephios-Session-Id": "018f0c00-0000-7000-8000-000000000001", "X-Cephios-Batch-Sequence": "101" },
        "preconditions": ["the per-session token bucket is depleted (100 req/sec baseline)"]
      }
    },
    "expected_output": {
      "error": { "category": "BufferError", "code": "ingest_rate_exceeded", "http_status": 429 },
      "response_headers": { "Retry-After": "1" }
    },
    "notes": "BufferError per CS §14.2 is the server-side HTTP 429 wire signal, distinct from the SDK-internal §7.7 BufferError/BufferEvent surface."
  },
  {
    "test_id": "error_consent_not_active_001",
    "category": "error_taxonomy",
    "protocol_version": "1.0",
    "description": "CONTRACT_SPEC.md §9.1 + §14.3: opening a session against a consent record that is missing, revoked, or subject-mismatched returns 403 ConsentError 'consent_not_active' (the three conditions unify to one wire shape to prevent existence-probing).",
    "input": {
      "request": {
        "method": "POST",
        "path": "/v1/sessions",
        "headers": { "Content-Type": "application/json", "Authorization": "Bearer <opaque-session-token>" },
        "body": {
          "session_id": "018f0c00-0000-7000-8000-000000000005",
          "workspace_id": "018f0c00-0000-7000-8000-000000000002",
          "subject_id": "018f0c00-0000-7000-8000-000000000003",
          "consent_record_id": "018f0c00-0000-7000-8000-0000000000ff",
          "modality": "EEG"
        }
      }
    },
    "expected_output": {
      "error": { "category": "ConsentError", "code": "consent_not_active", "http_status": 403 }
    },
    "notes": "CS §9.1:775; §14.2 ConsentError -> HTTP 403."
  },
  {
    "test_id": "error_authorization_not_yet_operational_001",
    "category": "error_taxonomy",
    "protocol_version": "1.0",
    "description": "CONTRACT_SPEC.md §14.3 + §12.2/§12.3: every POST /v1/grants call returns 403 AuthorizationError 'not_yet_operational' in MVP (the authorization gate ships empty; the response is returned before any DB touch).",
    "input": {
      "request": {
        "method": "POST",
        "path": "/v1/grants",
        "headers": { "Content-Type": "application/json", "Authorization": "Bearer <opaque-session-token>" },
        "body": {
          "grant_id": "018f0c00-0000-7000-8000-000000000001",
          "operation": "share-with-subject",
          "scope": { "subject_id": "018f0c00-0000-7000-8000-000000000002", "session_ids": [] },
          "expires_at": "2027-01-01T00:00:00Z"
        }
      }
    },
    "expected_output": {
      "error": { "category": "AuthorizationError", "code": "not_yet_operational", "http_status": 403 }
    },
    "notes": "The gate-stub shape per CS §14.3; §14.2 AuthorizationError -> HTTP 403. Both share-with-subject (§12.2) and cross-workspace-read (§12.3) operations return this in MVP."
  }
]
