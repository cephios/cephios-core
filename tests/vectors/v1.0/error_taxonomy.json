[
  {
    "test_id": "error_validation_batch_too_large_001",
    "category": "error_taxonomy",
    "protocol_version": "1.0",
    "description": "CONTRACT_SPEC.md §7.5 + §14.3: an ingest body exceeding the 16 MiB envelope maximum returns 400 ValidationError 'batch_too_large'.",
    "input": {
      "request": {
        "method": "POST",
        "path": "/v1/ingest",
        "headers": { "Content-Type": "application/octet-stream", "X-Cephios-API-Version": "1.0", "X-Cephios-Session-Id": "018f0c00-0000-7000-8000-000000000001", "X-Cephios-Batch-Sequence": "0" },
        "body_size_bytes": 16777217,
        "body_note": "16 * 1024 * 1024 + 1 bytes; constructed programmatically by the runner"
      }
    },
    "expected_output": {
      "error": { "category": "ValidationError", "code": "batch_too_large", "http_status": 400 }
    },
    "notes": "CS §7.5:489 maximum; §14.2 ValidationError -> HTTP 400."
  },
  {
    "test_id": "error_validation_session_not_open_001",
    "category": "error_taxonomy",
    "protocol_version": "1.0",
    "description": "CONTRACT_SPEC.md §14.3: POST against a session whose end_state != 'open' (closed, or cross-tenant/RLS-hidden) returns 400 ValidationError 'session_not_open'. The conflation prevents cross-tenant existence-probing.",
    "input": {
      "request": {
        "method": "POST",
        "path": "/v1/ingest",
        "headers": { "Content-Type": "application/octet-stream", "X-Cephios-API-Version": "1.0", "X-Cephios-Session-Id": "018f0c00-0000-7000-8000-000000000099", "X-Cephios-Batch-Sequence": "0" },
        "body_hex": "ce0f010104050607080910111213141516010203040506070809101112131415ff",
        "preconditions": ["session 018f0c00-0000-7000-8000-000000000099 is closed or not visible under the authenticated tenant"]
      }
    },
    "expected_output": {
      "error": { "category": "ValidationError", "code": "session_not_open", "http_status": 400 }
    },
    "notes": "CS §11.1 (publish) reuses the same disposition; §14.2 ValidationError -> HTTP 400."
  },
  {
    "test_id": "error_envelope_malformed_001",
    "category": "error_taxonomy",
    "protocol_version": "1.0",
    "description": "CONTRACT_SPEC.md §6.1 + §14.3: an ingest body whose magic bytes are not 0xCE 0x0F returns 400 EnvelopeError 'malformed' at the byte-level header check.",
    "input": {
      "request": {
        "method": "POST",
        "path": "/v1/ingest",
        "headers": { "Content-Type": "application/octet-stream", "X-Cephios-API-Version": "1.0", "X-Cephios-Session-Id": "018f0c00-0000-7000-8000-000000000001", "X-Cephios-Batch-Sequence": "0" },
        "body_hex": "dead010104050607080910111213141516010203040506070809101112131415ff"
      }
    },
    "expected_output": {
      "error": { "category": "EnvelopeError", "code": "malformed", "http_status": 400 }
    },
    "notes": "CS §6.1:329 magic; §14.2 EnvelopeError -> HTTP 400."
  },
  {
